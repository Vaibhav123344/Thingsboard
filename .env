# ThingsBoard API Configuration (accessible from host machine)
THINGSBOARD_HOST=http://localhost:8080
THINGSBOARD_USERNAME=tenant@thingsboard.org
THINGSBOARD_PASSWORD=tenant

# ThingsBoard MQTT Ingestion Configuration (for internal container connection)
THINGSBOARD_MQTT_HOST=localhost
THINGSBOARD_MQTT_PORT=1883

# Device Simulation Ingestion Tokens (populate these after Step 4 below)
SENSOR_01_TOKEN=your_sensor_01_token
SENSOR_02_TOKEN=your_sensor_02_token
SIMULATION_INTERVAL_SECONDS=15

